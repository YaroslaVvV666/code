[Unit]
Description=Orbita server
After=network.target

[Service]
User=orbita
WorkingDirectory=/opt/orbita/app
Environment=ORBITA_HOST=127.0.0.1
Environment=ORBITA_PORT=8080
Environment=ORBITA_DATA=/var/lib/orbita
Environment=ORBITA_MASTER_KEY_FILE=/etc/orbita.key
# Надёжнее, чем файл на диске: брать мастер-ключ из внешнего хранилища секретов (KMS/Vault).
# Тогда ключ не лежит рядом с данными, и при взломе сервера его не забрать «одним файлом».
# Закомментируйте строку ORBITA_MASTER_KEY_FILE выше и раскомментируйте одну из этих:
#Environment=ORBITA_MASTER_KEY_CMD=aws kms decrypt --ciphertext-blob fileb:///etc/orbita.key.enc --query Plaintext --output text
#Environment=ORBITA_MASTER_KEY_CMD=vault kv get -field=master_key secret/orbita
# Необязательно: отпечаток ожидаемого ключа — защита от тихой подмены (служба не стартует с чужим ключом).
#Environment=ORBITA_MASTER_KEY_FINGERPRINT=0000000000000000
Environment=ORBITA_DEMO=0
# Сервер за одним обратным прокси (Caddy) — настоящий IP клиента берётся из X-Forwarded-For.
# Если сервер смотрит в интернет напрямую (без Caddy) — поставьте 0, иначе IP можно подделать.
Environment=ORBITA_TRUSTED_PROXIES=1
# --- Настоящие push-уведомления Apple (APNs) ---
# Включатся автоматически, как только будут заданы все 4 значения и положен файл ключа.
# Нужен платный Apple Developer Program: developer.apple.com → Keys → «+» → Apple Push Notifications service (APNs) → скачать AuthKey_XXXXXXXXXX.p8
# Положите ключ в /etc/orbita-apns.p8 (chmod 600, chown orbita) и раскомментируйте строки ниже:
#Environment=ORBITA_APNS_KEY_FILE=/etc/orbita-apns.p8
#Environment=ORBITA_APNS_KEY_ID=XXXXXXXXXX
#Environment=ORBITA_APNS_TEAM_ID=XXXXXXXXXX
#Environment=ORBITA_APNS_TOPIC=com.yourcompany.Orbita
# Показывать текст сообщения в уведомлении (0 — скрыть, только «Новое сообщение»):
#Environment=ORBITA_PUSH_PREVIEW=1
# Проверка целостности кода перед каждым запуском: если server.py или любой .py подменили —
# служба не стартует. Эталон создаётся при деплое (setup.sh) командой integrity.sh generate.
ExecStartPre=/usr/bin/env bash /opt/orbita/app/deploy/integrity.sh verify /opt/orbita/app
ExecStart=/opt/orbita/venv/bin/python server.py
Restart=always
RestartSec=2

# --- Песочница systemd: ограничиваем, что служба может сделать, даже если её «пробьют» ---
# Файловая система почти вся только для чтения; писать можно лишь в данные и временные файлы.
ProtectSystem=strict
ReadWritePaths=/var/lib/orbita
ReadOnlyPaths=/opt/orbita/app
PrivateTmp=true
ProtectHome=true
# Запрет повышения прав и опасных возможностей ядра
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
PrivateDevices=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
