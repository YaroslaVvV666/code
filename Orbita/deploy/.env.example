# Скопируйте в .env и заполните. .env не коммитится.
PG_USER=orbita
PG_PASSWORD=СМЕНИТЕ_пароль_базы
PG_DB=orbita

# Сколько процессов-воркеров (обычно = числу ядер). Должно совпадать с числом server-строк в nginx.conf.
ORBITA_WORKERS=4

# Токен доступа к выгрузке данных по законному запросу. Пусто = ручки /v1/admin/* выключены.
ORBITA_ADMIN_TOKEN=

# Мастер-ключ шифрования (base64 от 32 байт). Сгенерировать:  python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Если пусто — создастся в томе app-data (/data/keys/master.key). ОБЯЗАТЕЛЬНО сделайте его резервную копию отдельно от данных.
ORBITA_MASTER_KEY=

# Медиа в S3 (необязательно; по умолчанию — на диске в томе app-data)
# ORBITA_S3_BUCKET=orbita-media
# ORBITA_S3_ENDPOINT=https://storage.yandexcloud.net
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
